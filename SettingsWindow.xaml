<Window x:Class="AuroraClock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora World Clock — Settings"
        Width="600" Height="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8FA6C2E0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="#EE0C1119" BorderBrush="#2EFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="6" Direction="270" Opacity="0.65" Color="#FF000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" x:Name="Header" Background="Transparent" Margin="22,18,18,6"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentSoftBrush}"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Aurora 世界时钟" FontSize="17" FontWeight="SemiBold" Foreground="#F2F6FC" />
                        <TextBlock x:Name="SubTitle" FontSize="11.5" Foreground="#8FA6C2E0" />
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="Close_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
                <StackPanel Margin="22,10,18,20">

                    <!-- ===== Clocks ===== -->
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="我的时钟  MY CLOCKS" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Button Content="+ 添加时钟" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                Padding="12,5" FontSize="12" Click="Add_Click" />
                    </Grid>

                    <ListBox x:Name="ClockList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             MaxHeight="300">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="11"
                                                Background="#24FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="15" Foreground="#F2F6FC"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding City}" Foreground="#F2F6FC"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11.5" Foreground="#8FA6C2E0">
                                                <Run Text="{Binding OffsetText, Mode=OneWay}" />
                                                <Run Text="  ·  " />
                                                <Run Text="{Binding Size, Mode=OneWay, StringFormat={}{0:0}px}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="&#xE774;" Style="{StaticResource IconButton}"
                                                Click="ChangeZone_Click" ToolTip="更改城市 / 时区" Margin="0,0,6,0" />
                                        <Button Grid.Column="3" Content="&#xEB9F;" Style="{StaticResource IconButton}"
                                                Click="FaceImage_Click" ToolTip="自定义表底图片" Margin="0,0,6,0" />
                                        <Button Grid.Column="4" Content="{Binding ShapeShort}" Style="{StaticResource GhostButton}"
                                                Padding="10,6" FontSize="12" Margin="2,0" Click="ToggleShape_Click" />
                                        <Button Grid.Column="5" Content="&#xE74D;" Style="{StaticResource IconButton}"
                                                Foreground="{StaticResource DangerBrush}" Click="Remove_Click"
                                                ToolTip="移除此时钟" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ===== Appearance ===== -->
                    <TextBlock Text="外观  APPEARANCE" Style="{StaticResource SectionTitle}" Margin="2,14,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="不透明度 Opacity" Foreground="#F2F6FC" FontSize="13" />
                                <TextBlock x:Name="OpacityValue" HorizontalAlignment="Right" Foreground="#8FA6C2E0" FontSize="12.5" />
                            </Grid>
                            <Slider x:Name="OpacitySlider" Style="{StaticResource GlassSlider}"
                                    Minimum="25" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="Opacity_Changed" />

                            <Grid Margin="0,14,0,6">
                                <TextBlock Text="玻璃浓度 Glass tint" Foreground="#F2F6FC" FontSize="13" />
                                <TextBlock x:Name="TintValue" HorizontalAlignment="Right" Foreground="#8FA6C2E0" FontSize="12.5" />
                            </Grid>
                            <Slider x:Name="TintSlider" Style="{StaticResource GlassSlider}"
                                    Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="Tint_Changed" />

                            <CheckBox x:Name="SwitchBlur" Style="{StaticResource ToggleSwitch}"
                                      Content="实时毛玻璃  Live frosted backdrop" Margin="0,14,0,0" Click="Option_Changed" />
                            <CheckBox x:Name="SwitchCapture" Style="{StaticResource ToggleSwitch}"
                                      Content="在截图/录屏中显示  Show in screenshots" Margin="0,12,0,0" Click="Option_Changed" />
                            <CheckBox x:Name="SwitchSeconds" Style="{StaticResource ToggleSwitch}"
                                      Content="显示秒针  Show seconds" Margin="0,12,0,0" Click="Option_Changed" />
                            <CheckBox x:Name="SwitchSmooth" Style="{StaticResource ToggleSwitch}"
                                      Content="平滑秒针  Smooth sweeping hand" Margin="0,12,0,0" Click="Option_Changed" />
                        </StackPanel>
                    </Border>

                    <!-- ===== Behaviour ===== -->
                    <TextBlock Text="行为  BEHAVIOUR" Style="{StaticResource SectionTitle}" Margin="2,14,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="SwitchTop" Style="{StaticResource ToggleSwitch}"
                                      Content="始终置顶  Always on top" Click="Option_Changed" />
                            <CheckBox x:Name="SwitchPass" Style="{StaticResource ToggleSwitch}"
                                      Content="指针穿透  Pointer click-through  (Ctrl+Alt+P)" Margin="0,12,0,0" Click="Option_Changed" />
                            <CheckBox x:Name="SwitchAuto" Style="{StaticResource ToggleSwitch}"
                                      Content="开机自启  Start with Windows" Margin="0,12,0,0" Click="Option_Changed" />
                            <CheckBox x:Name="SwitchSnap" Style="{StaticResource ToggleSwitch}"
                                      Content="边缘吸附  Snap to screen edges" Margin="0,12,0,0" Click="Option_Changed" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="排列全部时钟" Style="{StaticResource GhostButton}" Click="Tile_Click" Margin="0,0,10,0" />
                                <Button Content="显示全部时钟" Style="{StaticResource GhostButton}" Click="ShowAll_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== Hints ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Background="#0AFFFFFF">
                        <StackPanel>
                            <TextBlock Text="快捷键  HOTKEYS" Foreground="#8FA6C2E0" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="HotkeyText" Foreground="#9BB0C4E0" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="小提示  TIPS" Foreground="#8FA6C2E0" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0" />
                            <TextBlock Foreground="#9BB0C4E0" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="· 拖动小组件任意摆放，靠近屏幕边缘会自动吸附&#x0a;· 滚轮调整大小，Shift + 滚轮调整不透明度&#x0a;· 方向键微调位置，右键打开完整菜单&#x0a;· 开启指针穿透后请用托盘图标或快捷键操作" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="VersionText" Foreground="#5F7A96B4" FontSize="11.5" Margin="2,16,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
