<Window x:Class="AuroraClock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora — 设置"
        Width="620" Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Cel.MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Cel.TextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Cel.MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource CelCard}">
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="Padding" Value="14,12,14,14" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" Background="{DynamicResource Cel.PanelBrush}"
            BorderBrush="{DynamicResource Cel.EdgeBrush}" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="#615C8AA8" BlurRadius="30" ShadowDepth="5"
                              Direction="270" Opacity="0.55" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" x:Name="Header" Background="Transparent" Margin="22,18,18,6"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="11"
                            Background="{DynamicResource Cel.AccentBrush}"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource GlyphFont}"
                                   FontSize="15" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Aurora 设置" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource Cel.TextBrush}"
                                   FontFamily="{StaticResource DisplayFont}" />
                        <TextBlock x:Name="SubTitle" FontSize="11.5"
                                   Foreground="{DynamicResource Cel.MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="Close_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
                <StackPanel Margin="22,10,18,20">

                    <!-- ===== theme ===== -->
                    <TextBlock Text="主题  CEL THEME（赛璐璐 · 高透）" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="配色方案  Palette presets" Style="{StaticResource RowLabel}"
                                       Margin="0,0,0,8" />
                            <WrapPanel x:Name="PanelSwatches" Margin="0,0,0,14" />

                            <TextBlock Text="强调色  Accent" Style="{StaticResource RowLabel}"
                                       Margin="0,0,0,8" />
                            <WrapPanel x:Name="AccentSwatches" Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="面板透明度  Panel transparency" Style="{StaticResource RowLabel}" />
                                <TextBlock x:Name="AlphaValue" Style="{StaticResource RowValue}" />
                            </Grid>
                            <Slider x:Name="AlphaSlider" Style="{StaticResource GlassSlider}"
                                    Minimum="10" Maximum="95" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="Alpha_Changed" />

                            <Grid Margin="0,12,0,6">
                                <TextBlock Text="圆角  Corner radius" Style="{StaticResource RowLabel}" />
                                <TextBlock x:Name="RadiusValue" Style="{StaticResource RowValue}" />
                            </Grid>
                            <Slider x:Name="RadiusSlider" Style="{StaticResource GlassSlider}"
                                    Minimum="4" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="Radius_Changed" />

                            <CheckBox x:Name="SwitchCel" Style="{StaticResource ToggleSwitch}"
                                      Content="描边线条  Cel outline" Margin="0,14,0,0"
                                      Click="Theme_Changed" />
                            <CheckBox x:Name="SwitchShadow" Style="{StaticResource ToggleSwitch}"
                                      Content="贴纸投影  Sticker shadow" Margin="0,10,0,0"
                                      Click="Theme_Changed" />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="恢复默认配色" Style="{StaticResource GhostButton}"
                                        Click="ResetTheme_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== dock ===== -->
                    <TextBlock Text="右侧盒子  DOCK BOX" Style="{StaticResource SectionTitle}" Margin="2,16,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="SwitchDock" Style="{StaticResource ToggleSwitch}"
                                      Content="显示右侧盒子" Click="Dock_Changed" />
                            <CheckBox x:Name="SwitchDockFull" Style="{StaticResource ToggleSwitch}"
                                      Content="铺满右侧高度" Margin="0,10,0,0" Click="Dock_Changed" />
                            <CheckBox x:Name="SwitchDockAuto" Style="{StaticResource ToggleSwitch}"
                                      Content="自动隐藏（鼠标移入才展开）" Margin="0,10,0,0" Click="Dock_Changed" />

                            <Grid Margin="0,12,0,6">
                                <TextBlock Text="隐藏等待  Hide delay（鼠标离开后）" Style="{StaticResource RowLabel}" />
                                <TextBlock x:Name="DockDelayValue" Style="{StaticResource RowValue}" />
                            </Grid>
                            <Slider x:Name="DockDelaySlider" Style="{StaticResource GlassSlider}"
                                    Minimum="0.5" Maximum="15" TickFrequency="0.5"
                                    IsSnapToTickEnabled="True" ValueChanged="DockDelay_Changed" />

                            <Grid Margin="0,12,0,6">
                                <TextBlock Text="隐藏后预留  Hidden peek（0 = 完全隐藏）" Style="{StaticResource RowLabel}" />
                                <TextBlock x:Name="DockPeekValue" Style="{StaticResource RowValue}" />
                            </Grid>
                            <Slider x:Name="DockPeekSlider" Style="{StaticResource GlassSlider}"
                                    Minimum="0" Maximum="24" TickFrequency="1"
                                    IsSnapToTickEnabled="True" ValueChanged="DockPeek_Changed" />

                            <TextBlock Text="停靠位置  Dock edge" Style="{StaticResource RowLabel}"
                                       Margin="0,12,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="EdgeRightBtn" Content="靠右" Padding="16,6" />
                                <Button x:Name="EdgeLeftBtn" Content="靠左" Padding="16,6" Margin="6,0,0,0" />
                                <Button x:Name="EdgeTopBtn" Content="靠上" Padding="16,6" Margin="6,0,0,0" />
                                <Button x:Name="EdgeBottomBtn" Content="靠下" Padding="16,6" Margin="6,0,0,0" />
                            </StackPanel>

                            <CheckBox x:Name="SwitchBump" Style="{StaticResource ToggleSwitch}"
                                      Content="鼠标撞击屏幕边缘唤醒  Bump to reveal" Margin="0,12,0,0"
                                      Click="Dock_Changed" />

                            <CheckBox x:Name="SwitchDockFrost" Style="{StaticResource ToggleSwitch}"
                                      Content="盒子毛玻璃  Frost the dock" Margin="0,10,0,0" Click="Dock_Changed" />

                            <Grid Margin="0,12,0,6">
                                <TextBlock Text="盒子宽度  Dock width" Style="{StaticResource RowLabel}" />
                                <TextBlock x:Name="DockWidthValue" Style="{StaticResource RowValue}" />
                            </Grid>
                            <Slider x:Name="DockWidthSlider" Style="{StaticResource GlassSlider}"
                                    Minimum="240" Maximum="560" TickFrequency="2" IsSnapToTickEnabled="True"
                                    ValueChanged="DockWidth_Changed" />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="添加启动项…" Style="{StaticResource AccentButton}"
                                        Click="AddLauncher_Click" Margin="0,0,10,0" />
                                <Button Content="隐藏 / 显示盒子" Style="{StaticResource GhostButton}"
                                        Click="DockToggle_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== clocks ===== -->
                    <Grid Margin="0,16,0,8">
                        <TextBlock Text="我的时钟  MY CLOCKS" Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center" />
                        <Button Content="+ 添加时钟" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right" Padding="12,5" FontSize="12"
                                Click="Add_Click" />
                    </Grid>

                    <ListBox x:Name="ClockList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled" MaxHeight="300">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CelCard}" Margin="0,0,0,8" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="12"
                                                Background="{DynamicResource Cel.AccentBrush}"
                                                VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE823;" FontFamily="{StaticResource GlyphFont}"
                                                       FontSize="15" Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding City}"
                                                       Foreground="{DynamicResource Cel.TextBrush}"
                                                       FontSize="13.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11.5"
                                                       Foreground="{DynamicResource Cel.MutedBrush}">
                                                <Run Text="{Binding OffsetText, Mode=OneWay}" />
                                                <Run Text="  ·  " />
                                                <Run Text="{Binding Size, Mode=OneWay, StringFormat={}{0:0}px}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="&#xE774;"
                                                Style="{StaticResource CelIconButton}"
                                                Click="ChangeZone_Click" ToolTip="更改城市 / 时区"
                                                Margin="0,0,4,0" />
                                        <Button Grid.Column="3" Content="&#xEB9F;"
                                                Style="{StaticResource CelIconButton}"
                                                Click="FaceImage_Click" ToolTip="自定义表底图片"
                                                Margin="0,0,4,0" />
                                        <Button Grid.Column="4" Content="{Binding ShapeShort}"
                                                Style="{StaticResource GhostButton}"
                                                Padding="10,6" FontSize="12" Margin="2,0"
                                                Click="ToggleShape_Click" />
                                        <Button Grid.Column="5" Content="&#xE74D;"
                                                Style="{StaticResource CelIconButton}"
                                                Foreground="{DynamicResource DangerBrush}"
                                                Click="Remove_Click" ToolTip="移除此时钟" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ===== appearance ===== -->
                    <TextBlock Text="时钟外观  CLOCK APPEARANCE" Style="{StaticResource SectionTitle}"
                               Margin="2,16,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="不透明度  Opacity" Style="{StaticResource RowLabel}" />
                                <TextBlock x:Name="OpacityValue" Style="{StaticResource RowValue}" />
                            </Grid>
                            <Slider x:Name="OpacitySlider" Style="{StaticResource GlassSlider}"
                                    Minimum="25" Maximum="100" TickFrequency="1"
                                    IsSnapToTickEnabled="True" ValueChanged="Opacity_Changed" />

                            <Grid Margin="0,12,0,6">
                                <TextBlock Text="玻璃浓度  Glass tint" Style="{StaticResource RowLabel}" />
                                <TextBlock x:Name="TintValue" Style="{StaticResource RowValue}" />
                            </Grid>
                            <Slider x:Name="TintSlider" Style="{StaticResource GlassSlider}"
                                    Minimum="0" Maximum="100" TickFrequency="1"
                                    IsSnapToTickEnabled="True" ValueChanged="Tint_Changed" />

                            <CheckBox x:Name="SwitchBlur" Style="{StaticResource ToggleSwitch}"
                                      Content="实时毛玻璃  Live frosted backdrop" Margin="0,14,0,0"
                                      Click="Option_Changed" />
                            <CheckBox x:Name="SwitchCapture" Style="{StaticResource ToggleSwitch}"
                                      Content="在截图 / 录屏中显示  Show in screenshots"
                                      Margin="0,10,0,0" Click="Option_Changed" />
                            <CheckBox x:Name="SwitchSeconds" Style="{StaticResource ToggleSwitch}"
                                      Content="显示秒  Show seconds" Margin="0,10,0,0"
                                      Click="Option_Changed" />
                            <CheckBox x:Name="SwitchSmooth" Style="{StaticResource ToggleSwitch}"
                                      Content="平滑秒针  Smooth sweeping hand" Margin="0,10,0,0"
                                      Click="Option_Changed" />
                        </StackPanel>
                    </Border>

                    <!-- ===== behaviour ===== -->
                    <TextBlock Text="行为  BEHAVIOUR" Style="{StaticResource SectionTitle}" Margin="2,16,0,8" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="SwitchTop" Style="{StaticResource ToggleSwitch}"
                                      Content="始终置顶  Always on top" Click="Option_Changed" />
                            <CheckBox x:Name="SwitchPass" Style="{StaticResource ToggleSwitch}"
                                      Content="指针穿透  Pointer click-through" Margin="0,10,0,0"
                                      Click="Option_Changed" />
                            <CheckBox x:Name="SwitchAuto" Style="{StaticResource ToggleSwitch}"
                                      Content="开机自启  Start with Windows" Margin="0,10,0,0"
                                      Click="Option_Changed" />
                            <CheckBox x:Name="SwitchSnap" Style="{StaticResource ToggleSwitch}"
                                      Content="边缘吸附  Snap to screen edges" Margin="0,10,0,0"
                                      Click="Option_Changed" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="排列全部时钟" Style="{StaticResource GhostButton}"
                                        Click="Tile_Click" Margin="0,0,10,0" />
                                <Button Content="显示全部时钟" Style="{StaticResource GhostButton}"
                                        Click="ShowAll_Click" />
                            </StackPanel>

                            <CheckBox x:Name="SwitchFloating" Style="{StaticResource ToggleSwitch}"
                                      Content="浮动时钟组件（可选，盒子已包含时钟）"
                                      Margin="0,16,0,0" Click="Floating_Changed" />
                        </StackPanel>
                    </Border>

                    <!-- ===== hints ===== -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="快捷键  HOTKEYS" Style="{StaticResource SectionTitle}"
                                       Margin="0" />
                            <TextBlock x:Name="HotkeyText" Foreground="{DynamicResource Cel.TextBrush}"
                                       FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="小提示  TIPS" Style="{StaticResource SectionTitle}"
                                       Margin="0,12,0,0" />
                            <TextBlock Foreground="{DynamicResource Cel.MutedBrush}" FontSize="12"
                                       Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="· 拖动盒子标题栏移动，拖左边缘改宽度，靠近右侧会自动吸附&#x0a;· 启动项支持程序、文件夹，以及 cmd 命令 + 工作目录&#x0a;· 滚轮调整时钟大小，方向键微调位置，右键打开完整菜单&#x0a;· 开启指针穿透后请用托盘图标或快捷键操作" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource Cel.MutedBrush}"
                               FontSize="11" Margin="2,16,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
