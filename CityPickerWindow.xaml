<Window x:Class="AuroraClock.CityPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Clock"
        Width="420" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#F2F6FC" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="9" Background="Transparent" Padding="12,9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#457CC4FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="#EE0C1119" BorderBrush="#2EFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="6" Direction="270" Opacity="0.6" Color="#FF000000" />
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" x:Name="Header" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="添加世界时钟" FontSize="17" FontWeight="SemiBold"
                           Foreground="#F2F6FC" VerticalAlignment="Center" />
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right"
                        Click="Cancel_Click" />
            </Grid>

            <!-- search -->
            <Border Grid.Row="1" CornerRadius="11" Background="#1FFFFFFF" BorderBrush="#26FFFFFF"
                    BorderThickness="1" Margin="0,14,0,12" Padding="12,0" Height="42">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               Foreground="#9BB0C4E0" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource SearchBox}"
                             TextChanged="SearchBox_TextChanged" />
                    <TextBlock x:Name="Placeholder" Grid.Column="1" Text="搜索城市或时区…"
                               Foreground="#66A9BAD0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- list -->
            <ListBox x:Name="List" Grid.Row="2" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="List_MouseDoubleClick"
                     SelectionChanged="List_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Offset}" FontSize="12"
                                       Foreground="#8FA6C2E0" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- footer -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <TextBlock x:Name="CountText" Foreground="#8FA6C2E0" VerticalAlignment="Center" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消 Cancel" Style="{StaticResource GhostButton}"
                            Click="Cancel_Click" Margin="0,0,10,0" />
                    <Button Content="添加 Add" Style="{StaticResource AccentButton}"
                            Click="Add_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
