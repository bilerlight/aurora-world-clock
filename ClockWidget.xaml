<Window x:Class="AuroraClock.ClockWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:AuroraClock.Controls"
        Title="Aurora Clock"
        Width="210" Height="210"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid x:Name="Root" Background="Transparent">
        <Border x:Name="Glass" CornerRadius="105" Background="#B80C1119"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="EntranceScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="EntranceMove" X="0" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>

            <Grid>
                <!-- Analog face (circle mode) -->
                <ctl:AnalogClock x:Name="BigClock" />

                <!-- Digital card (square mode) -->
                <Grid x:Name="SquareCard" Opacity="0" Visibility="Collapsed" Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="MiniColumn" Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ctl:AnalogClock x:Name="MiniClock" Grid.Column="0"
                                     Width="66" Height="66" VerticalAlignment="Center"
                                     ShowDigital="False" ShowCity="False" ShowDate="False"
                                     ShowNumbers="False" ShowSecondHand="False" />

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CityText"
                                   Foreground="#F2F6FC"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TimeText"
                                   Foreground="#F2F6FC"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SecondsText"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="DateText"
                                   Foreground="#9BB0C4E0"
                                   FontFamily="Segoe UI Variable Text, Segoe UI" />
                    </StackPanel>
                </Grid>

                <!-- Glass sheen -->
                <Border x:Name="Sheen" CornerRadius="105" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                            <GradientStop Color="#2EFFFFFF" Offset="0" />
                            <GradientStop Color="#0CFFFFFF" Offset="0.40" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Diffuse light bloom, upper-left -->
                <Border x:Name="Bloom" CornerRadius="105" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush GradientOrigin="0.30,0.22" Center="0.30,0.22"
                                             RadiusX="0.65" RadiusY="0.65">
                            <GradientStop Color="#1FFFFFFF" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Inner hairline rim -->
                <Border x:Name="Rim" CornerRadius="105" IsHitTestVisible="False"
                        BorderThickness="1" BorderBrush="#26FFFFFF" />

                <!-- Accent glow rim (hover) -->
                <Border x:Name="GlowRim" CornerRadius="105" IsHitTestVisible="False"
                        BorderThickness="1.6" Opacity="0">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#FF7CC4FF" />
                    </Border.BorderBrush>
                </Border>

                <!-- Amber rim = click-through active -->
                <Border x:Name="PassRim" CornerRadius="105" IsHitTestVisible="False"
                        BorderThickness="1.6" Opacity="0">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#FFFFC46B" />
                    </Border.BorderBrush>
                </Border>

                <!-- Frosted grain -->
                <Border x:Name="Noise" CornerRadius="105" IsHitTestVisible="False" Opacity="0" />
            </Grid>
        </Border>
    </Grid>
</Window>
