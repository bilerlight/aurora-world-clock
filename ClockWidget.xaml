<Window x:Class="AuroraClock.ClockWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:AuroraClock.Controls"
        Title="Aurora Clock"
        Width="210" Height="210"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid x:Name="Root" Background="Transparent">
        <Border x:Name="Glass" CornerRadius="105" Background="Transparent"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="EntranceScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="EntranceMove" X="0" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>

            <Grid>
                <!-- 1. the real, shaped frosted backdrop (captured + blurred behind the widget) -->
                <Border x:Name="Backdrop" CornerRadius="105" IsHitTestVisible="False">
                    <Border.Background>
                        <ImageBrush x:Name="BackdropBrush" Stretch="Fill" />
                    </Border.Background>
                </Border>

                <!-- 2. glass tint for contrast -->
                <Border x:Name="Tint" CornerRadius="105" IsHitTestVisible="False" Background="#8C0A0F18" />

                <!-- 2b. optional custom dial image -->
                <Border x:Name="FaceImageClip" CornerRadius="105" IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <Border.Background>
                        <ImageBrush x:Name="FaceBrush" Stretch="UniformToFill"
                                    AlignmentX="Center" AlignmentY="Center" />
                    </Border.Background>
                </Border>

                <!-- 3. clock content -->
                <ctl:AnalogClock x:Name="BigClock" />

                <Grid x:Name="SquareCard" Opacity="0" Visibility="Collapsed" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- city left, date right -->
                    <Grid Grid.Row="0">
                        <TextBlock x:Name="CityText"
                                   HorizontalAlignment="Left"
                                   Foreground="#F2F6FC"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DateText"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="#9BB0C4E0"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- the hero: the big time fills the width -->
                    <Grid Grid.Row="1">
                        <TextBlock x:Name="TimeText"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Foreground="#F2F6FC"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontWeight="SemiBold" />
                    </Grid>

                    <!-- seconds readout + full-width progress -->
                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="SecondsText"
                                   HorizontalAlignment="Left"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontWeight="SemiBold" />
                        <Grid Height="5" Margin="0,4,0,0">
                            <Border x:Name="SecondsTrack" CornerRadius="2.5" Background="#12FFFFFF" />
                            <Border x:Name="SecondsBar" CornerRadius="2.5" HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}" Width="0" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 4. glass sheen + diffuse bloom -->
                <Border x:Name="Sheen" CornerRadius="105" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                            <GradientStop Color="#30FFFFFF" Offset="0" />
                            <GradientStop Color="#0CFFFFFF" Offset="0.40" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border x:Name="Bloom" CornerRadius="105" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush GradientOrigin="0.30,0.22" Center="0.30,0.22"
                                             RadiusX="0.65" RadiusY="0.65">
                            <GradientStop Color="#24FFFFFF" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 5. rim + hover / click-through rings -->
                <Border x:Name="Rim" CornerRadius="105" IsHitTestVisible="False"
                        BorderThickness="1" BorderBrush="#26FFFFFF" />

                <Border x:Name="GlowRim" CornerRadius="105" IsHitTestVisible="False"
                        BorderThickness="1.6" Opacity="0">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#FF7CC4FF" />
                    </Border.BorderBrush>
                </Border>

                <Border x:Name="PassRim" CornerRadius="105" IsHitTestVisible="False"
                        BorderThickness="1.6" Opacity="0" Visibility="Collapsed" />

                <!-- 6. frosted grain -->
                <Border x:Name="Noise" CornerRadius="105" IsHitTestVisible="False" Opacity="0.55" />
            </Grid>
        </Border>
    </Grid>
</Window>
