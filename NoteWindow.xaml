<Window x:Class="AuroraClock.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Note"
        Width="250" Height="190"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True">

    <Window.Resources>
        <DrawingBrush x:Key="PaperDots" TileMode="Tile"
                      Viewport="0,0,9,9" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#16000000">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="4.5,4.5" RadiusX="1.1" RadiusY="1.1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Pop" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <Border x:Name="Shadow" CornerRadius="14" Background="#66000000" Margin="6,6,-6,-6" />
        <Border x:Name="Paper" CornerRadius="14" Margin="0,0,6,6"
                Background="#FFFBEFB8" BorderBrush="#FF14110A" BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" />
            </Border.Effect>
            <Grid>
                <Border CornerRadius="12" Background="{StaticResource PaperDots}" />

                <Grid x:Name="Header" Background="Transparent" Height="30" VerticalAlignment="Top"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock x:Name="HintText" Text="便签" Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="Bold"
                               FontSize="12" Foreground="#FF6B5B22" />
                    <TextBlock x:Name="CountdownText" HorizontalAlignment="Right" Margin="0,0,40,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
                               Foreground="#FF8A6D18" />
                    <Button Content="&#xE8BB;" Click="Close_Click"
                            Style="{StaticResource CloseButton}" Width="26" Height="26"
                            Margin="0,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Foreground="#FF6B5B22" />
                </Grid>

                <TextBox x:Name="Text" Background="Transparent" BorderThickness="0"
                         Margin="12,34,12,12" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontSize="15"
                         FontFamily="Segoe UI Variable Text, Segoe UI"
                         Foreground="#FF241E10" CaretBrush="#FF241E10"
                         TextChanged="Text_TextChanged" />
            </Grid>
        </Border>
    </Grid>
</Window>
