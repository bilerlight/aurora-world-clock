<Window x:Class="AuroraClock.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora 中心"
        Width="660" Height="660"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F6FC" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="Transparent" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Input" TargetType="TextBox" BasedOn="{StaticResource SearchBox}">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="ListBoxItemFlat" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="#F00C1119" BorderBrush="#2EFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="6" Direction="270" Opacity="0.65" Color="#FF000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid x:Name="Header" Background="Transparent" Margin="22,16,16,10"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Aurora 中心" FontSize="17" FontWeight="SemiBold" Foreground="#F2F6FC" />
                    <TextBlock x:Name="SubText" FontSize="11.5" Foreground="#8FA6C2E0"
                               VerticalAlignment="Bottom" Margin="10,0,0,3" />
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="Close_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- nav -->
                <StackPanel Grid.Column="0" Margin="4,4,10,0">
                    <Button x:Name="NavTodo" Style="{StaticResource NavButton}" Content="☑  待办 Todo" Click="Nav_Click" Tag="todo" />
                    <Button x:Name="NavRemind" Style="{StaticResource NavButton}" Content="⏰  提醒 Reminders" Click="Nav_Click" Tag="remind" />
                    <Button x:Name="NavNote" Style="{StaticResource NavButton}" Content="📝  便签 Notes" Click="Nav_Click" Tag="note" />
                    <Button x:Name="NavUsage" Style="{StaticResource NavButton}" Content="📊  用量 Usage" Click="Nav_Click" Tag="usage" />
                </StackPanel>

                <!-- ============ TODO ============ -->
                <Grid x:Name="PaneTodo" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TodoInput" Style="{StaticResource Input}"
                                     KeyDown="TodoInput_KeyDown" />
                            <Button Grid.Column="1" Content="添加" Style="{StaticResource AccentButton}"
                                    Padding="14,6" FontSize="12" Click="TodoAdd_Click" />
                        </Grid>
                    </Border>
                    <ListBox x:Name="TodoList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             Margin="0,10,0,0" ItemContainerStyle="{StaticResource ListBoxItemFlat}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Done, Mode=OneWay}"
                                                  Click="Todo_Check" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock x:Name="txt" Grid.Column="1" Text="{Binding Text}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="#F2F6FC" FontSize="13.5" />
                                        <Button Grid.Column="2" Content="&#xE74D;" Style="{StaticResource IconButton}"
                                                Foreground="{StaticResource DangerBrush}" Click="Todo_Delete" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                        <Setter TargetName="txt" Property="TextDecorations" Value="Strikethrough" />
                                        <Setter TargetName="txt" Property="Opacity" Value="0.45" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- ============ REMINDERS ============ -->
                <Grid x:Name="PaneRemind" Grid.Column="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RemindTime" Style="{StaticResource Input}" Text="09:00" />
                                <TextBox x:Name="RemindText" Grid.Column="1" Style="{StaticResource Input}"
                                         Margin="10,0,10,0" KeyDown="RemindText_KeyDown" />
                                <Button Grid.Column="2" Content="添加" Style="{StaticResource AccentButton}"
                                        Padding="14,6" FontSize="12" Click="RemindAdd_Click" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ComboBox x:Name="RemindRepeat" Width="150" FontSize="12.5" />
                                <TextBlock x:Name="WeekHint" VerticalAlignment="Center" Margin="12,0,0,0"
                                           FontSize="11.5" Foreground="#8FA6C2E0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="RemindList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             Margin="0,10,0,0" ItemContainerStyle="{StaticResource ListBoxItemFlat}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=OneWay}"
                                                  Click="Remind_Toggle" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Text="{Binding Time}" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Text}" Foreground="#F2F6FC" FontSize="13.5"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding RepeatLabel}" Foreground="#8FA6C2E0"
                                                       FontSize="11.5" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Content="&#xE74D;" Style="{StaticResource IconButton}"
                                                Foreground="{StaticResource DangerBrush}" Click="Remind_Delete" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- ============ NOTES ============ -->
                <Grid x:Name="PaneNote" Grid.Column="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="10">
                        <StackPanel>
                            <TextBox x:Name="NoteText" Style="{StaticResource Input}"
                                     AcceptsReturn="False" KeyDown="NoteText_KeyDown" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ComboBox x:Name="NoteLife" Width="150" FontSize="12.5" />
                                <Button Content="添加便签" Style="{StaticResource AccentButton}"
                                        Padding="14,6" FontSize="12" Margin="10,0,0,0" Click="NoteAdd_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="NoteList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             Margin="0,10,0,0" ItemContainerStyle="{StaticResource ListBoxItemFlat}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="10,8"
                                        Background="#18FFE9A8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Text}" Foreground="#F2F6FC" FontSize="13.5"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="life" Text="{Binding Life}" Foreground="#8FA6C2E0" FontSize="11.5"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="显示" Style="{StaticResource GhostButton}"
                                                Padding="10,5" FontSize="11.5" Margin="6,0,0,0" Click="Note_Show" />
                                        <Button Grid.Column="2" Content="&#xE8BB;" Style="{StaticResource IconButton}"
                                                Click="Note_Hide" ToolTip="从桌面收起" />
                                        <Button Grid.Column="3" Content="&#xE74D;" Style="{StaticResource IconButton}"
                                                Foreground="{StaticResource DangerBrush}" Click="Note_Delete" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- ============ USAGE ============ -->
                <Grid x:Name="PaneUsage" Grid.Column="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="UsageOffline" Style="{StaticResource Card}" Visibility="Collapsed"
                            Background="#1AFF8A8A">
                        <TextBlock x:Name="UsageOfflineText" Foreground="#FFFFC9C9" FontSize="13"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border x:Name="UsageLive" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="今日用量 Today" Foreground="#8FA6C2E0" FontSize="12"
                                           FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="UsageUpdated" Foreground="#8FA6C2E0" FontSize="11.5"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Content="刷新" Style="{StaticResource GhostButton}"
                                            Padding="10,5" FontSize="11.5" Click="UsageRefresh_Click" />
                                    <CheckBox x:Name="UsageWidgetToggle" Style="{StaticResource ToggleSwitch}"
                                              Content="桌面组件" Margin="10,0,0,0" Click="UsageWidget_Toggle" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="UsageCost" Text="$0.00" Foreground="#F2F6FC"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontWeight="SemiBold" FontSize="34" Margin="0,6,0,0" />
                            <TextBlock x:Name="UsageTokens" Foreground="#9BB0C4E0" FontSize="12" />
                            <TextBlock x:Name="UsageRecent" Foreground="#8FA6C2E0" FontSize="11.5" />
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="UsageList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                             Margin="0,10,0,0" ItemContainerStyle="{StaticResource ListBoxItemFlat}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding App}" Foreground="#F2F6FC"
                                                   FontSize="13.5" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Tokens}" Foreground="#9BB0C4E0"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Requests}" Foreground="#9BB0C4E0"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding Cost}" Foreground="{StaticResource AccentBrush}"
                                                   FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
